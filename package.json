{
  "name": "fc-ai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture:template": "tsx scripts/fixtures.ts template",
    "fixture:add": "tsx scripts/fixtures.ts add",
    "fixture:check": "tsx scripts/fixtures.ts check",
    "solver:install": "pip install -r solver/requirements.txt",
    "solver:test": "cd solver && python3 -m pytest tests -q",
    "solver:dev": "cd solver && python3 -m uvicorn fc_ai_solver.app:app --host 127.0.0.1 --port 8000 --reload",
    "test:all": "npm run typecheck && npm run test && npm run check:branches && npm run solver:test",
    "crosscheck:generate": "tsx scripts/generate-chemistry-crosscheck.ts",
    "solver:test:fast": "cd solver && python3 -m pytest tests -q -m \"not slow\"",
    "check:branches": "tsx scripts/checkBranchPolicy.ts main",
    "hooks:install": "git config core.hooksPath .githooks && echo \"pre-push hook installed\"",
    "check:clean": "tsx scripts/safeHistory.ts check",
    "git:reset": "tsx scripts/safeHistory.ts reset",
    "fcai": "tsx scripts/fcai.ts",
    "sample:generate": "tsx scripts/generateSampleData.ts",
    "quickstart": "tsx scripts/quickstart.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "web:dev": "next dev -p 3000"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
